PORT=3001
DB_PATH=./data/travel-companion.db
ALLOWED_CORS_ORIGIN=https://smajla82-hub.github.io
NODE_ENV=development
# JWT_SECRET must be set to a long, random, unique value in production.
# This placeholder is for local development only — never deploy with it.
JWT_SECRET=change-me-to-a-long-random-secret-in-production
# Optional: how long issued JWTs stay valid (e.g. 7d, 12h, 3600s). Defaults to 7d.
JWT_EXPIRES_IN=7d
# Optional: pending invitation lifetime in days. Defaults to 7.
INVITATION_EXPIRES_IN_DAYS=7
# Optional: edit-lock lifetime in milliseconds. Clients should heartbeat every 30–60 seconds. Defaults to 120000.
TRIP_LOCK_TTL_MS=120000
# Optional: how long a password reset link stays valid, in minutes. Defaults to 60.
PASSWORD_RESET_EXPIRES_IN_MINUTES=60
# The frontend origin (including any sub-path, no trailing slash) used to build
# the password reset link sent by email, e.g. https://smajla82-hub.github.io/TravelCompanion.
# Defaults to the production GitHub Pages deployment if unset.
APP_BASE_URL=https://smajla82-hub.github.io/TravelCompanion
# SMTP settings used to send password reset emails. If SMTP_HOST is left
# empty, emails are logged to the server console instead of being sent —
# useful for local development, but never for production.
SMTP_HOST=
SMTP_PORT=587
# Set to "true" only for implicit TLS ports such as 465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Travel Companion <no-reply@travel-companion.local>
