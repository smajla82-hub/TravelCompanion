PORT=3001
DB_PATH=./data/travel-companion.db
ALLOWED_CORS_ORIGIN=https://smajla82-hub.github.io
NODE_ENV=development
# JWT_SECRET must be set to a long, random, unique value in production.
# This placeholder is for local development only — never deploy with it.
JWT_SECRET=change-me-to-a-long-random-secret-in-production
# Optional: how long issued JWTs stay valid (e.g. 7d, 12h, 3600s). Defaults to 7d.
JWT_EXPIRES_IN=7d
# Optional: pending invitation lifetime in days. Defaults to 7.
INVITATION_EXPIRES_IN_DAYS=7
# Optional: edit-lock lifetime in milliseconds. Clients should heartbeat every 30–60 seconds. Defaults to 120000.
TRIP_LOCK_TTL_MS=120000
